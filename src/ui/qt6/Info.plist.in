<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>jt-filework</string>
    <key>CFBundleDisplayName</key>
    <string>jt-filework</string>
    <key>CFBundleExecutable</key>
    <string>jt-filework</string>
    <key>CFBundleIdentifier</key>
    <string>${MACOSX_BUNDLE_GUI_IDENTIFIER}</string>
    <key>CFBundleIconFile</key>
    <string>jt-filework</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>${MACOSX_BUNDLE_SHORT_VERSION_STRING}</string>
    <key>CFBundleVersion</key>
    <string>${MACOSX_BUNDLE_BUNDLE_VERSION}</string>
    <key>LSMinimumSystemVersion</key>
    <string>${CMAKE_OSX_DEPLOYMENT_TARGET}</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <!-- The languages this application speaks.
         macOS picks an application's language from the localizations its
         bundle declares, intersected with the user's preferred languages. A
         bundle that declares none is treated as English-only, and everything
         the system localizes *on the application's behalf* comes back in
         English: UTType.localizedDescription (the Kind column),
         NSFileManager displayNameAtPath (the sidebar's Desktop and
         Downloads), and QLocale::system(), which is why that reported en_TW
         on a Chinese machine.
         Declared here rather than by shipping .strings files, because the
         translations live in locales/ and are resolved by our own catalogue.
    -->
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleLocalizations</key>
    <array>
        <string>en</string>
        <string>zh-Hant</string>
    </array>
    <!-- A file manager reads the user's whole disk by definition, so it asks
         for the folders macOS gates rather than failing silently in them. -->
    <key>NSDesktopFolderUsageDescription</key>
    <string>jt-filework shows the files in your Desktop folder.</string>
    <key>NSDocumentsFolderUsageDescription</key>
    <string>jt-filework shows the files in your Documents folder.</string>
    <key>NSDownloadsFolderUsageDescription</key>
    <string>jt-filework shows the files in your Downloads folder.</string>
    <key>NSRemovableVolumesUsageDescription</key>
    <string>jt-filework shows the files on removable volumes.</string>
    <key>NSNetworkVolumesUsageDescription</key>
    <string>jt-filework shows the files on network volumes.</string>
</dict>
</plist>
