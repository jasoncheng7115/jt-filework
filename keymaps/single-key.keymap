# jt-filework — Single-Key Mode
#
# Execute common file commands directly with single keys. Inspired by the
# keyboard-driven workflow of classic tools such as CView / WinCV; see
# docs/KEYBOARD_PROFILE.md for why the mode is not named after them.
#
# Taken from CView's own help file, not inferred: cview/CVIEW/CV.HLP §二
# (檔案選取畫面) and §三 (觀看檔案時), plus the hint strings in WinCV's
# 2026-08-14 test build. The full table, with provenance and the two points
# still unresolved, is docs/design/CVIEW_KEYS.md.
#
# CView and WinCV share nearly all of their keys — same author — so the DOS
# help is the base and WinCV is confirmation.
#
# Where a command does not exist yet the binding is simply absent rather than
# bound to something approximate. docs/design/CVIEW_KEYS.md lists what is
# missing.

# In CView a bare letter is a command, not a jump to a file name. Type-ahead
# would swallow C, M, R, D, V and E before the bindings below ever saw them.
!type_ahead          = off

# --- navigation
# CV.HLP: BACKSPACE 相當於 'CD..'  ·  P \ 到所指定的路徑
# WinCV adds the left arrow for the same thing; right is its counterpart.
left                 = nav.up                    # wincv
backspace            = nav.up                    # CV.HLP
right                = file.open                 # confirmed
enter                = file.open                 # CV.HLP 觀看該檔案(或進入該目錄)
p                    = nav.goto                  # CV.HLP
alt+left             = nav.back
alt+right            = nav.forward
primary+home         = nav.home

# --- marking
# CV.HLP: SPACE 標記 · Alt-T 全標 · Alt-U 全不標 · + - 依條件 · * 反轉
space                = file.mark.toggle          # CV.HLP, confirmed
t                    = file.mark.all             # confirmed
alt+t                = file.mark.all             # CV.HLP
alt+u                = file.mark.none            # CV.HLP
asterisk             = file.mark.invert          # CV.HLP, confirmed
plus                 = file.mark.pattern         # CV.HLP
f9                   = file.mark.pattern         # CV.HLP
minus                = file.unmark.pattern       # CV.HLP

# --- files
# CV.HLP: C/INS 拷貝 · M 移動 · R 改檔名 · D/DEL 刪除 · T 垃圾桶 · V 看檔
# WinCV: E 編輯
c                    = file.copy_to_target_pane  # CV.HLP
insert               = file.copy_to_target_pane  # CV.HLP
m                    = file.move_to_target_pane  # CV.HLP
r                    = file.rename               # CV.HLP
d                    = file.delete               # CV.HLP
delete               = file.delete               # CV.HLP
# `T` marks every file, confirmed against WinCV. CV.HLP gives DOS CView's `T`
# as delete-to-trash instead - the one place the two versions disagree - and
# the later behaviour wins. Trash keeps the host platform's chord.
primary+backspace    = file.trash
v                    = file.view                 # CV.HLP
e                    = file.edit                 # wincv
alt+r                = file.batch_rename         # wincv 連續編號改名
primary+u            = file.undo
primary+shift+r      = file.reveal
primary+d            = file.duplicate
f7                   = file.new_folder

# --- clipboard
primary+c            = file.clipboard.copy
primary+x            = file.clipboard.cut
primary+v            = file.clipboard.paste

# --- panes and tabs
# TAB switches list format in CView; here it moves between panes, because
# CView had no panes and something has to.
tab                  = workspace.pane.next
shift+tab            = workspace.pane.previous
primary+t            = tab.new
primary+w            = tab.close
primary+shift+t      = tab.reopen
# Tab switching. CView had no tabs, so these follow the browser conventions
# every user already has in their fingers rather than inventing something.
ctrl+tab             = tab.next
ctrl+shift+tab       = tab.previous
primary+alt+right    = tab.next
primary+alt+left     = tab.previous
# Pane switching. Cmd-` cycles windows on macOS, and a pane is the same idea
# one level down, so the gesture transfers.
primary+grave        = workspace.pane.next
primary+shift+grave  = workspace.pane.previous
primary+shift+backslash = workspace.split.vertical
primary+backslash    = workspace.split.horizontal
primary+1            = workspace.preset.single
primary+4            = workspace.preset.quad

# --- view
primary+shift+e      = view.tree
primary+alt+i        = view.inspector
# The keyboard-mode toggle. Bound to the same chord in BOTH presets on
# purpose: a switch that only exists in the mode you left is a door that locks
# behind you. tests/tests/keymaps.rs proves the two agree.
primary+shift+k      = keymap.toggle
primary+slash        = help.shortcuts
primary+shift+slash  = view.key_hints
primary+2            = view.mode.list
primary+3            = view.mode.grid
s                    = view.sort               # confirmed
primary+shift+period = view.hidden
f5                   = view.refresh
primary+equal        = view.font.larger
primary+minus        = view.font.smaller

# --- search
# CV.HLP: F / F6 find a string in the listing. That is what our filter does -
# it narrows the folder you are in - so it takes those keys, and the recursive
# search keeps the platform chord.
f                    = view.filter               # confirmed
f6                   = view.filter               # confirmed
primary+f            = search.open
escape               = search.clear
primary+shift+p      = command.palette
primary+comma        = settings.open
