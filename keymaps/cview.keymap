# jt-filework — CView / WinCV keymap
#
# INCOMPLETE. Parts of this map were inferred from the Norton Commander
# lineage rather than taken from CView's own key table, and at least one
# inference was wrong: bare letters are commands in CView, which the first
# draft did not account for. Bindings confirmed by a CView user are marked
# `# confirmed`; the rest are provisional and should be checked against the
# real key table before release.
#
# Where a command does not exist yet the binding is simply absent rather than
# bound to something approximate.
#
# On macOS the function row is media keys by default. To use this preset as
# intended, turn on:
#   System Settings -> Keyboard -> "Use F1, F2, etc. keys as standard
#   function keys"
# Otherwise hold Fn together with the function key.

# In CView a bare letter is a command, not a jump to a file name: `e` edits,
# `v` views. Type-ahead would swallow those keys before the binding below ever
# saw them, so the preset turns it off.
!type_ahead          = off

# --- the function row
f2                   = file.rename
f3                   = file.view
f4                   = file.edit
f5                   = file.copy_to_target_pane
f6                   = file.move_to_target_pane
f7                   = file.new_folder
f8                   = file.trash

# --- panes and tabs
tab                  = workspace.pane.next
shift+tab            = workspace.pane.previous
primary+t            = tab.new
primary+w            = tab.close
primary+shift+backslash = workspace.split.vertical
primary+backslash    = workspace.split.horizontal
primary+1            = workspace.preset.single
primary+4            = workspace.preset.quad

# --- navigation
left                 = nav.up            # confirmed
right                = file.open
backspace            = nav.up
ctrl+pageup          = nav.up
alt+left             = nav.back
alt+right            = nav.forward
primary+home         = nav.home

# --- marking: Space marks, as CView and WinCV always did. Quick Look moves to
#     Finder's own shortcut so Space keeps its original meaning.
space                = file.mark.toggle
primary+y            = preview.quicklook
primary+a            = file.mark.all
primary+z            = file.mark.none
primary+i            = file.mark.invert

# --- files
e                    = file.edit         # confirmed
v                    = file.view         # confirmed
primary+d            = file.duplicate
primary+shift+m      = file.batch_rename
primary+shift+r      = file.reveal
primary+u            = file.undo

# --- clipboard
primary+c            = file.clipboard.copy
primary+x            = file.clipboard.cut
primary+v            = file.clipboard.paste

# --- view
ctrl+r               = view.refresh
ctrl+h               = view.hidden
primary+e            = view.filter
primary+shift+e      = view.tree
primary+alt+i        = view.inspector
primary+b            = file.bookmark

# --- search
primary+f            = search.open
primary+comma        = settings.open
primary+shift+p    = command.palette
plus                 = file.mark.pattern
minus                = file.unmark.pattern
